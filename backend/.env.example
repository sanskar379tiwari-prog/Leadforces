# =============================================================================
# Leadforces backend — environment variables
# Copy to .env and fill in values. This stack does NOT use AWS_*, ANTHROPIC_*,
# GROQ_*, or any CRM (HubSpot / Salesforce) keys.
# =============================================================================

# Server
PORT=3000
# Public URL Twilio webhooks hit (Render URL, e.g. https://leadforces-backend.onrender.com)
PUBLIC_BASE_URL=https://your-backend.onrender.com
FRONTEND_URL=http://localhost:5173

# --- Twilio Voice -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Speech (Deepgram) ------------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# If true, use Twilio SpeechResult only (no Deepgram HTTP call)
DEEPGRAM_FALLBACK=true

# --- TTS: Cartesia (primary) → Supabase Storage → signed URL for <Play> -----
# If key missing, or CARTESIA_FALLBACK=true, or upload fails → Twilio <Say> (native voice)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=b10f179c-66ee-4be9-9eec-a44fef1fb5d8
CARTESIA_FALLBACK=true

# --- LLM — Google Gemini only (Google AI Studio) ---------------------------
# Used for: BANT/MEDDIC framework pick, next question (Alex), JSON field extract,
# numeric score fallback, CDR summary JSON.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Supabase PostgreSQL (direct connection string from Project Settings) ---
# Project Settings → Database → Connection string → URI (use "Transaction" or "Session" pooler as recommended)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Supabase API (Storage: upload MP3 + createSignedUrl for Twilio) ---------
SUPABASE_URL=https://[ref].supabase.co
# Service role key (server only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket created in Dashboard or via supabase/supabase_sql_editor.sql
SUPABASE_STORAGE_BUCKET=tts
